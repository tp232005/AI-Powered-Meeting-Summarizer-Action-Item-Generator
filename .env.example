# Optional: enables OpenAI speech-to-text (OPENAI_API_KEY is also recognized).
# Without an API key, the app uses the local Whisper backend.
SPEECH_TO_TEXT_API_KEY=

# Optional runtime settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=openai/whisper-tiny.en
MAX_AUDIO_FILE_SIZE_MB=1024
AUDIO_CHUNK_SECONDS=180
TRANSCRIPT_CHUNK_CHARS=12000
DEFAULT_OUTPUT_LANGUAGE=English
# Optional persistent data locations; recordings are stored as files, not SQLite blobs.
# MEETING_DATABASE_PATH=
# MEETING_RECORDINGS_DIR=

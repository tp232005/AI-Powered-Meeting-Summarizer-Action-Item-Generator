# Required for OpenAI speech-to-text (preferred)
SPEECH_TO_TEXT_API_KEY=your_speech_to_text_api_key_here

# Optional if you also use a separate LLM API provider
LLM_API_KEY=your_llm_api_key_here

# Optional runtime settings
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
WHISPER_MODEL=openai/whisper-tiny.en
MAX_AUDIO_FILE_SIZE_MB=25
AUDIO_CHUNK_SECONDS=600
